OOT","children":[{"objectName":"NewText"}]},"events":[],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0,"shadowDistance":2000.0,"shadowNormalBias":1.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","shadowRenderingMode":"fittedToCameraView","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"}]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Game Scene"},{"itemName":"Untitled scene"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"A drag box selects one unit, and a click sends it walking there while the other units stay put. Runs for both keyboard (right-click to move) and touchscreen (left-click to move) control schemes.","lastRunAt":1787843583439.0,"lastRunDurationMs":635.0,"lastRunFramesExecuted":156,"lastRunStatus":"passed","name":"Selecting a unit and ordering it to move","type":"gameplay","source":["const dragSelectionBox = async (fromX, fromY, toX, toY, layerName) => {","  harness.setMousePosition(fromX, fromY, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(20);","  const STEPS = 15;","  for (let step = 1; step <= STEPS; step++) {","    harness.setMousePosition(","      fromX + ((toX - fromX) * step) / STEPS,","      fromY + ((toY - fromY) * step) / STEPS,","      layerName","    );","    await harness.stepFrames(1);","  }","  await harness.stepFrames(5);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","const leftClickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","const rightClickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'right');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'right');","  await harness.stepFrames(3);","};","","const runScenario = async (label, controlType) => {","  await harness.goToScene('Game Scene');","  harness.watch('RTSUnit');","  harness.setSceneVariable('ControlType', controlType);","  await harness.stepFrames(5);","","  const getUnitById = (id) => harness.getObjects('RTSUnit').find((one) => one.id === id);","","  const units = harness.getObjects('RTSUnit');","  harness.assert(units.length > 1, '[' + label + '] There are several units on the map.');","  const target = units[0];","  const others = units.slice(1);","  console.log(","    '[' + label + '] units=' + units.length +","      ' selecting the one at ' + Math.round(target.centerX) + ',' + Math.round(target.centerY)","  );","","  const margin = target.width / 2 + 10;","  await dragSelectionBox(","    target.centerX - margin,","    target.centerY - margin,","    target.centerX + margin,","    target.centerY + margin,","    target.layer","  );","","  const positionsBeforeOrder = new Map(","    harness.getObjects('RTSUnit').map((one) => [one.id, one])","  );","","  const destinationX = target.centerX + 220;","  const destinationY = target.centerY + 160;","  if (controlType === 'Touchscreen') {","    await leftClickAt(destinationX, destinationY, target.layer);","  } else {","    await rightClickAt(destinationX, destinationY, target.layer);","  }","","  const movedTowardDestination = await harness.stepUntil(","    () => {","      const unit = getUnitById(target.id);","      const before = positionsBeforeOrder.get(target.id);","      return (","        Math.hypot(","          unit.centerX - before.centerX,","          unit.centerY - before.centerY","        ) > 60","      );","    },","    { maxFrames: 300 }","  );","","  const movedUnit = getUnitById(target.id);","  const movedDistance = Math.hypot(","    movedUnit.centerX - positionsBeforeOrder.get(target.id).centerX,","    movedUnit.centerY - positionsBeforeOrder.get(target.id).centerY","  );","  let othersThatMoved = 0;","  for (const other of others) {","    const now = getUnitById(other.id);","    const before = positionsBeforeOrder.get(other.id);","    if (","      now &&","      before &&","      Math.hypot(now.centerX - before.centerX, now.centerY - before.centerY) > 10","    ) {","      othersThatMoved++;","    }","  }","  console.log(","    '[' + label + '] selectedUnitMoved=' + Math.round(movedDistance) +","      ' othersThatMoved=' + othersThatMoved","  );","","  harness.assert(","    movedTowardDestination,","    '[' + label + '] The selected unit walks to where it was ordered (it moved ' +","      Math.round(movedDistance) + 'px).'","  );","  harness.assert(","    othersThatMoved === 0,","    '[' + label + '] The units that were not selected stay where they are (' +","      othersThatMoved + ' of them moved).'","  );","};","","await runScenario('Keyboard', 'Keyboard');","await runScenario('Touchscreen', 'Touchscreen');"]},{"description":"A drag box over all the units selects them, and one click sends the whole group walking. Runs for both keyboard (right-click to move) and touchscreen (left-click to move) control schemes.","lastRunAt":1787843616765.0,"lastRunDurationMs":449.0,"lastRunFramesExecuted":144,"lastRunStatus":"passed","name":"Selecting every unit at once","type":"gameplay","source":["const dragSelectionBox = async (fromX, fromY, toX, toY, layerName) => {","  harness.setMousePosition(fromX, fromY, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(20);","  const STEPS = 15;","  for (let step = 1; step <= STEPS; step++) {","    harness.setMousePosition(","      fromX + ((toX - fromX) * step) / STEPS,","      fromY + ((toY - fromY) * step) / STEPS,","      layerName","    );","    await harness.stepFrames(1);","  }","  await harness.stepFrames(5);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","const leftClickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(3);","};","","const rightClickAt = async (x, y, layerName) => {","  harness.setMousePosition(x, y, layerName);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true, 'right');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'right');","  await harness.stepFrames(3);","};","","const runScenario = async (label, controlType) => {","  await harness.goToScene('Game Scene');","  harness.watch('RTSUnit');","  harness.setSceneVariable('ControlType', controlType);","  await harness.stepFrames(5);","","  const getUnitById = (id) => harness.getObjects('RTSUnit').find((one) => one.id === id);","","  const units = harness.getObjects('RTSUnit');","  harness.assert(units.length > 1, '[' + label + '] There are several units on the map.');","","  const left = Math.min(...units.map((one) => one.centerX)) - 60;","  const right = Math.max(...units.map((one) => one.centerX)) + 60;","  const top = Math.min(...units.map((one) => one.centerY)) - 60;","  const bottom = Math.max(...units.map((one) => one.centerY)) + 60;","  const layerName = units[0].layer;","  console.log(","    '[' + label + '] units=' + units.length +","      ' box=' + Math.round(left) + ',' + Math.round(top) +","      ' -> ' + Math.round(right) + ',' + Math.round(bottom)","  );","","  await dragSelectionBox(left, top, right, bottom, layerName);","","  const positionsBeforeOrder = new Map(","    harness.getObjects('RTSUnit').map((one) => [one.id, one])","  );","","  const destinationX = (left + right) / 2;","  const destinationY = bottom + 120;","  if (controlType === 'Touchscreen') {","    await leftClickAt(destinationX, destinationY, layerName);","  } else {","    await rightClickAt(destinationX, destinationY, layerName);","  }","","  let unitsThatMoved = 0;","  await harness.stepUntil(","    () => {","      unitsThatMoved = 0;","      for (const [id, before] of positionsBeforeOrder) {","        const now = getUnitById(id);","        if (","          now &&","          Math.hypot(now.centerX - before.centerX, now.centerY - before.centerY) > 40","        ) {","          unitsThatMoved++;","        }","      }","      return unitsThatMoved === positionsBeforeOrder.size;","    },","    { maxFrames: 400 }","  );","","  console.log(","    '[' + label + '] unitsThatMoved=' + unitsThatMoved + ' of ' + positionsBeforeOrder.size","  );","  harness.assert(","    unitsThatMoved === positionsBeforeOrder.size,","    '[' + label + '] Every unit of the selection walks to where the group was ordered (' +","      unitsThatMoved + ' of ' + positionsBeforeOrder.size + ' moved).'","  );","};","","await runScenario('Keyboard', 'Keyboard');","await runScenario('Touchscreen', 'Touchscreen');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Selecting a unit and ordering it to move"},{"itemName":"Selecting every unit at once"}]},"eventsFunctionsExtensions":[{"author":"Slash, Tristan Rhodes, @VictrisGames","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"RTS-like unit selection","gdevelopVersion":">=5.5.222","helpPath":"https://victrisgames.itch.io/rts-like-unit-selection","iconUrl":"data:image/svg+xml;base64,","name":"RTSUnitSelection","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/pencil-box-outline.svg","shortDescription":"Allow player to select units by clicking on them or dragging a selection box.","version":"2.4.0","description":["How To Use:","- The \"Allow player to select units\" action must run every frame to work properly","- When a drag is in progress, all units inside the selection box will be \"PreSelected\"","- When the drag is released, all \"PreSelected\" units will be changed to \"Selected\"","- Hold the additive select key to add units to selection","- Hold the subtractive select key to remove units from selection","","Control Group controls:","- Ctrl + (1,2,3,4,5,6,7,9,0) assigns that Control Group to Selected units","- (1,2,3,4,5,6,7,9,0) selects all units that are assigned to that Control Group","","Selection box:","- When dragging, the selection area will be drawn by a Shape Painter object. ","- If a Shape Painter instance has not been added in the scene, it will be created automatically.","- To change the appearance of the selection area, change the Shape Painter properties.","- Reduce the fill opacity of the SelectionBox (shape painter object) so that units and terrain can be seen behind it.","","Tips:","- Use the \"Preselected\" and \"Selected\" conditions to highlight units that are being interacted with","- Create an object group (i.e. \"SelectableUnits\") to control which types of objects can be selected","- Use conditions to restrict which object instances can be selected. ","- Use the \"SelectedUnitID\" to design formations of units.","- Shape painter object should be on the same layer as the units being selected","- Always use ForEach() events when using the conditions in this extension because extension conditions do not currently perform object picking."],"origin":{"identifier":"RTSUnitSelection","name":"gdevelop-extension-store"},"tags":["mouse","cursor","pointer","rts","unit","select","selector","selection","multi-select","control group"],"authorIds":["gqDaZjCfevOOxBYkK6zlhtZnXCg1","jZp7TS5D4NeOcwG8NCSu2vIzVWI2"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Allow player to select units by clicking on them or dragging a selection box.","fullName":"Allow player to select units by clicking on them or dragging a selection box","functionType":"Action","name":"RTSUnitSelection","sentence":"Allow player to select _PARAM1_ with _PARAM7_ mouse button (or touch). Draw a selection box using _PARAM2_ on Layer: _PARAM3_ with Z order: _PARAM4_. Hold _PARAM5_ to add units and _PARAM6_ to remove units","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"RTSUnitSelection Extension","source":"","type":"BuiltinCommonInstructions::Group","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"Setup shape painter for selection box","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Create shape painter (if one hasn't been added already)"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NbObjet"},"parameters":["SelectionBox","=","0"]}],"actions":[{"type